{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Clusters",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "expr": "count(count by (clique_id) (fl_current_round))", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Nodes",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "expr": "count(fl_current_round)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Global Round",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "expr": "max(fl_current_round)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Global Test Accuracy",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "expr": "avg(fl_accuracy{dataset=\"test\"})", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Converged Clusters",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{ "expr": "sum(min by (clique_id) (fl_cluster_converged))", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Avg Delta Norm",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "expr": "avg(fl_delta_norm)", "refId": "A" }]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Accuracy",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Test Accuracy by Node",
      "description": "Per-node test accuracy over time",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "auto" },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] } },
      "targets": [
        { "expr": "fl_accuracy{dataset=\"test\", clique_id=~\"$clique\", node_id=~\"$node\"}", "refId": "A", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Avg Accuracy by Clique",
      "description": "Average test accuracy per clique over time",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "avg by (clique_id) (fl_accuracy{dataset=\"test\", clique_id=~\"$clique\"})", "refId": "A", "legendFormat": "Clique {{clique_id}}" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Accuracy by Round (Train / Val / Test)",
      "description": "Per-round accuracy averaged across selected nodes",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "pointSize": 5, "showPoints": "always" },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        { "expr": "avg by (round) (last_over_time(fl_accuracy_by_round{dataset=\"train\", clique_id=~\"$clique\", node_id=~\"$node\"}[1h]))", "refId": "A", "legendFormat": "Train R{{round}}", "instant": true, "format": "table" },
        { "expr": "avg by (round) (last_over_time(fl_accuracy_by_round{dataset=\"validation\", clique_id=~\"$clique\", node_id=~\"$node\"}[1h]))", "refId": "B", "legendFormat": "Val R{{round}}", "instant": true, "format": "table" },
        { "expr": "avg by (round) (last_over_time(fl_accuracy_by_round{dataset=\"test\", clique_id=~\"$clique\", node_id=~\"$node\"}[1h]))", "refId": "C", "legendFormat": "Test R{{round}}", "instant": true, "format": "table" }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Convergence",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Delta Norm by Node",
      "description": "Model parameter delta norm per node — lower means more convergence",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 4,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "fl_delta_norm{clique_id=~\"$clique\", node_id=~\"$node\"}", "refId": "A", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Convergence Streak by Clique",
      "description": "Consecutive rounds where delta norm stayed below threshold",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "none" } },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "avg by (clique_id) (fl_convergence_streak{clique_id=~\"$clique\"})", "refId": "A", "legendFormat": "Clique {{clique_id}}" }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Convergence Status by Clique",
      "description": "1 = converged, 0 = not converged",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Training", "color": "orange" }, "1": { "text": "Converged", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "orientation": "horizontal" },
      "targets": [
        { "expr": "min by (clique_id) (fl_cluster_converged{clique_id=~\"$clique\"})", "refId": "A", "legendFormat": "Clique {{clique_id}}" }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Timing",
      "gridPos": { "x": 0, "y": 33, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Avg Local Training Time",
      "description": "Average local training time per node (seconds)",
      "gridPos": { "x": 0, "y": 34, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "rate(fl_local_training_seconds_sum{clique_id=~\"$clique\"}[2m]) / rate(fl_local_training_seconds_count{clique_id=~\"$clique\"}[2m])", "refId": "A", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Avg Aggregation Time",
      "description": "Average secure aggregation time per node (seconds)",
      "gridPos": { "x": 8, "y": 34, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "rate(fl_aggregation_seconds_sum{clique_id=~\"$clique\"}[2m]) / rate(fl_aggregation_seconds_count{clique_id=~\"$clique\"}[2m])", "refId": "A", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Avg Round Total Time",
      "description": "Average total round time per node (training + aggregation + communication)",
      "gridPos": { "x": 16, "y": 34, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        { "expr": "rate(fl_round_total_seconds_sum{clique_id=~\"$clique\"}[2m]) / rate(fl_round_total_seconds_count{clique_id=~\"$clique\"}[2m])", "refId": "A", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "Network & Resources",
      "gridPos": { "x": 0, "y": 41, "w": 24, "h": 1 },
      "collapsed": true,
      "panels": [
        {
          "id": 44,
          "type": "stat",
          "title": "Total Bytes Sent (All Nodes)",
          "description": "Cumulative bytes sent by all selected nodes since start",
          "gridPos": { "x": 0, "y": 42, "w": 8, "h": 4 },
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "color": { "mode": "palette-classic" }
            }
          },
          "options": {
            "reduceOptions": { "calcs": ["lastNotNull"] },
            "colorMode": "value",
            "graphMode": "none"
          },
          "targets": [
            { "expr": "sum(fl_bytes_sent_total{clique_id=~\"$clique\"})", "refId": "A" }
          ]
        },
        {
          "id": 45,
          "type": "stat",
          "title": "Avg Bytes Sent / Node",
          "description": "Cumulative average bytes sent per selected node",
          "gridPos": { "x": 8, "y": 42, "w": 8, "h": 4 },
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "color": { "mode": "palette-classic" }
            }
          },
          "options": {
            "reduceOptions": { "calcs": ["lastNotNull"] },
            "colorMode": "value",
            "graphMode": "none"
          },
          "targets": [
            { "expr": "avg(fl_bytes_sent_total{clique_id=~\"$clique\"})", "refId": "A" }
          ]
        },
        {
          "id": 46,
          "type": "timeseries",
          "title": "Node Connections",
          "description": "Topology degree (number of connections) per node",
          "gridPos": { "x": 16, "y": 42, "w": 8, "h": 4 },
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "custom": { "drawStyle": "line", "fillOpacity": 20 },
              "color": { "mode": "palette-classic" }
            }
          },
          "targets": [
            { "expr": "fl_node_connections{clique_id=~\"$clique\"}", "refId": "A", "legendFormat": "{{node_id}}" }
          ]
        },
        {
          "id": 41,
          "type": "timeseries",
          "title": "Messages Sent / Received",
          "gridPos": { "x": 0, "y": 46, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 }, "color": { "mode": "palette-classic" } } },
          "targets": [
            { "expr": "rate(fl_messages_sent_total{clique_id=~\"$clique\"}[2m])", "refId": "A", "legendFormat": "sent {{node_id}}" },
            { "expr": "rate(fl_messages_received_total{clique_id=~\"$clique\"}[2m])", "refId": "B", "legendFormat": "recv {{node_id}}" }
          ]
        },
        {
          "id": 42,
          "type": "timeseries",
          "title": "Bytes Sent / Received",
          "gridPos": { "x": 12, "y": 46, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 }, "color": { "mode": "palette-classic" } } },
          "targets": [
            { "expr": "rate(fl_bytes_sent_total{clique_id=~\"$clique\"}[2m])", "refId": "A", "legendFormat": "sent {{node_id}}" },
            { "expr": "rate(fl_bytes_received_total{clique_id=~\"$clique\"}[2m])", "refId": "B", "legendFormat": "recv {{node_id}}" }
          ]
        },
        {
          "id": 43,
          "type": "timeseries",
          "title": "SAP Phase Duration",
          "description": "Secure Aggregation Protocol phase durations",
          "gridPos": { "x": 0, "y": 53, "w": 24, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } }, "color": { "mode": "palette-classic" } } },
          "targets": [
            { "expr": "rate(fl_sap_phase_seconds_sum{clique_id=~\"$clique\"}[2m]) / rate(fl_sap_phase_seconds_count{clique_id=~\"$clique\"}[2m])", "refId": "A", "legendFormat": "{{phase}} - {{node_id}}" }
          ]
        }
      ]
    },
    {
      "id": 50,
      "type": "row",
      "title": "Topology",
      "gridPos": { "x": 0, "y": 56, "w": 24, "h": 1 },
      "collapsed": true,
      "panels": [
        {
          "id": 51,
          "type": "stat",
          "title": "Nodes per Clique",
          "gridPos": { "x": 0, "y": 57, "w": 12, "h": 4 },
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "palette-classic" } } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "orientation": "horizontal" },
          "targets": [
            { "expr": "count by (clique_id) (fl_current_round)", "refId": "A", "legendFormat": "Clique {{clique_id}}" }
          ]
        },
        {
          "id": 52,
          "type": "stat",
          "title": "Model Parameters",
          "gridPos": { "x": 12, "y": 57, "w": 6, "h": 4 },
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
          "targets": [
            { "expr": "max(fl_model_parameters)", "refId": "A" }
          ]
        },
        {
          "id": 53,
          "type": "stat",
          "title": "Training Samples (per node)",
          "gridPos": { "x": 18, "y": 57, "w": 6, "h": 4 },
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "palette-classic" } } },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "orientation": "horizontal" },
          "targets": [
            { "expr": "fl_training_samples", "refId": "A", "legendFormat": "{{node_id}}" }
          ]
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["federated-learning", "metrics", "prometheus"],
  "templating": {
    "list": [
      {
        "name": "prom_ds",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2
      },
      {
        "name": "clique",
        "type": "query",
        "label": "Clique",
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "query": "label_values(fl_current_round, clique_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node",
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "query": "label_values(fl_current_round{clique_id=~\"$clique\"}, node_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Federated Learning - Cluster Metrics",
  "uid": "fl-cluster-metrics",
  "version": 1
}
